# Enterprise Knowledge Assistant - Environment Variables
# -------------------------------------------------------
# Copy this file to .env and fill in the values
# NEVER commit .env to version control

# Application
APP_NAME=Enterprise Knowledge Assistant
APP_ENV=development
SECRET_KEY=change-me-in-production-use-a-long-random-string
ALLOWED_ORIGINS=http://localhost:3000
# JWT access token lifetime (minutes). 1440 = 24h.
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Runtime (app_user only — never superuser / BYPASSRLS / table owner)
DATABASE_URL=postgresql+psycopg://app_user:app_user@localhost:5436/ekb
# Owner — Alembic only. The app process must never use this URL.
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5436/ekb
APP_DB_USER=app_user
APP_DB_PASSWORD=app_user

# Redis
REDIS_URL=redis://localhost:6379/0

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Retrieval backend: postgres (default) or qdrant
SEARCH_BACKEND=postgres

# LLM (OpenAI)
# LLM (Groq — OpenAI-compatible API; the `openai` package is used with a base_url)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Embedding
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384
EMBEDDING_DIMENSION=384

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50
