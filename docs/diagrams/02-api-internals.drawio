    <diagram id="upload-flow" name="02b-Upload-Flow">
        <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1300" pageHeight="950" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="t" value="Upload / Ingest Flow — durable per-doc queue" style="text;html=1;strokeColor=none;fillColor=none;fontSize=18;fontStyle=1;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="520" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="t2" value="One failure must not drop other docs. Disk + DB row outlive the queue message." style="text;html=1;strokeColor=none;fillColor=none;fontSize=11;fontColor=#000000;" vertex="1" parent="1">
                    <mxGeometry x="40" y="48" width="560" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="s1" value="1. Manager/Admin&#10;JWT + file(s)&#10;+ allowed roles" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="40" y="100" width="130" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="s2" value="2. Auth&#10;reject if role&#10;= user" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="200" y="100" width="110" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="s3" value="3. Upload API&#10;FOR EACH file:&#10;disk write&#10;DB pending row&#10;enqueue(doc_id)&#10;return ids" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="340" y="80" width="140" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="s4" value="4. Durable Queue&#10;job = doc_id only&#10;(Redis + worker OK)" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#000000;strokeColor=#000000;fontSize=11;fontColor=#FFFFFF;" parent="1" vertex="1">
                    <mxGeometry x="520" y="100" width="150" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="s5" value="5. Worker&#10;load doc from DB&#10;read disk path&#10;parse → chunk&#10;→ embed → save" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="710" y="80" width="140" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="ok" value="6a. success&#10;status = ready&#10;chunks searchable" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="710" y="260" width="140" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="retry" value="6b. transient&#10;(timeout, OOM,&#10;embed API down)&#10;→ retry same doc_id&#10;file kept on disk" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="500" y="250" width="160" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="fail" value="6c. document error&#10;(corrupt / bad type)&#10;status = failed&#10;file kept for audit&#10;other docs unaffected" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="900" y="250" width="160" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="note" value="Multi-upload = N independent jobs. Doc B failing never deletes Doc A’s disk/DB row.&#10;Delete: manager/admin only (user cannot upload → user cannot delete)." style="text;html=1;strokeColor=none;fillColor=none;fontSize=11;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="40" y="400" width="700" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;endArrow=block;endFill=1;" parent="1" source="s1" target="s2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="a2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;endArrow=block;endFill=1;" parent="1" source="s2" target="s3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="a3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;endArrow=block;endFill=1;" parent="1" source="s3" target="s4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="a4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;endArrow=block;endFill=1;" parent="1" source="s4" target="s5" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="a5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;endArrow=block;endFill=1;" parent="1" source="s5" target="ok" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="a6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;endArrow=block;endFill=1;" parent="1" source="s5" target="retry" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="a7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;endArrow=block;endFill=1;" parent="1" source="s5" target="fail" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="a8" value="re-queue" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontSize=10;fontColor=#000000;dashed=1;endArrow=block;endFill=1;" parent="1" source="retry" target="s4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="ask-flow" name="02c-Ask-Flow">
        <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1200" pageHeight="900" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="t" value="Ask Flow (any logged-in role) — Option B" style="text;html=1;strokeColor=none;fillColor=none;fontSize=18;fontStyle=1;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="520" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="b1" value="1. Client&#10;JWT + question" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="40" y="120" width="110" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="b2" value="2. Auth&#10;read org_id&#10;user_id · role" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="180" y="120" width="110" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="b3" value="3. Ask API&#10;open DB txn&#10;SET LOCAL&#10;org + role" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="320" y="110" width="120" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="b4" value="4. Retrieval&#10;search chunks&#10;RLS hides&#10;forbidden docs" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="480" y="110" width="120" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="b5" value="5. Database&#10;returns ONLY&#10;allowed chunks" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;align=center;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="640" y="100" width="120" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="split" value="hits?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="480" y="260" width="100" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="b6" value="6a. Answer&#10;prompt = question&#10;+ allowed chunks&#10;→ LLM" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="320" y="380" width="130" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="b7" value="6b. Safe reply&#10;Not found in docs&#10;you can access.&#10;no sources&#10;no existence leak" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="640" y="380" width="150" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="b8" value="7. Response&#10;answer + sources" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="320" y="520" width="140" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="why" value="Why B: DB never returns forbidden chunks → LLM never sees them." style="text;html=1;strokeColor=none;fillColor=none;fontSize=11;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="40" y="640" width="520" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="c1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;endArrow=block;endFill=1;" parent="1" source="b1" target="b2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="c2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;endArrow=block;endFill=1;" parent="1" source="b2" target="b3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="c3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;endArrow=block;endFill=1;" parent="1" source="b3" target="b4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
